opam-version: "2.0"
maintainer: "Wolfgang Meier"
version: "dev"

homepage: "https://github.com/womeier/rocq-base64"
dev-repo: "git+https://github.com/womeier/rocq-base64.git"
bug-reports: "https://github.com/womeier/rocq-base64/issues"
license: "MIT"

synopsis: "Verified RFC 4648 base64 encoding and decoding in Rocq"
description: """
Base64 encoding and decoding. A ByteString type class lifts the theory to byte
lists, to the standard library's strings and to Rocq's primitive strings.
A bridge to MetaRocq's bytestrings ships as the separate rocq-base64-bytestring package.
"""

build: [make "-j%{jobs}%"]
install: [make "install"]
depends: [
  "rocq-core" {>= "9.0" }
  "rocq-stdlib"
]

tags: [
  "category:Computer Science/Data Types and Data Structures"
  "keyword:base64"
  "keyword:RFC 4648"
  "keyword:strings"
  "keyword:bytes"
  "logpath:Base64"
]
authors: [
  "Wolfgang Meier"
]
